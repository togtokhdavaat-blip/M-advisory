# ---- Local development (works with no external accounts) ----
APP_URL=http://localhost:3000
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/m_advisory
AUTH_PROVIDER=local
SESSION_SECRET=replace-with-64-random-characters-openssl-rand-base64-48
PAYMENT_PROVIDER=mock
STORAGE_PROVIDER=local

# ---- Production (Supabase + Vercel + QPay) ----
# APP_ENV=production
# APP_URL=https://advisory.mproperties.mn
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# AUTH_PROVIDER=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server only, never NEXT_PUBLIC_
# STORAGE_PROVIDER=supabase
# PAYMENT_PROVIDER=qpay
# QPAY_BASE_URL=https://merchant.qpay.mn
# QPAY_USERNAME=
# QPAY_PASSWORD=
# QPAY_INVOICE_CODE=
# QPAY_CALLBACK_SECRET=             # 32+ random characters
# CRON_SECRET=                      # 32+ random characters; Vercel Cron sends it as a Bearer token
# RESEND_API_KEY=                   # optional: email notifications
# EMAIL_FROM="M ADVISORY <no-reply@mproperties.mn>"
# DOCUMENT_RETENTION_DAYS=          # optional: purge client documents after N days
# MALWARE_SCAN_URL=                 # optional: virus scan hook for uploads
# MALWARE_SCAN_TOKEN=
